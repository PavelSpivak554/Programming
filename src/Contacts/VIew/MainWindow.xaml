<Window x:Class="View.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converters="clr-namespace:View.Converters"
        mc:Ignorable="d"
        Title="Contacts" 
        Height="450" 
        Width="500"
        WindowStartupLocation="CenterScreen"
        MinWidth="550" 
        MinHeight="400">

    <Window.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="150"/>
            <ColumnDefinition Width="3"/>
            <ColumnDefinition Width="*" MinWidth="250"/>
        </Grid.ColumnDefinitions>

        <!-- Левая панель - список контактов -->
        <Grid Grid.Column="0" Background="#F8F8F8">
            <Grid Margin="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Верхняя панель: текст "Find:" + поле поиска -->
                <Grid Grid.Row="0" Margin="0,0,0,3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" 
                               Text="Find:" 
                               Foreground="#666"
                               VerticalAlignment="Center"
                               Margin="0,0,5,0"/>

                    <TextBox Grid.Column="1" 
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Height="25" 
                             Padding="3"
                             BorderBrush="#ccc"
                             BorderThickness="1"/>
                </Grid>

                <!-- Список контактов -->
                <ListBox Grid.Row="1" 
                         ItemsSource="{Binding Contacts}"
                         SelectedItem="{Binding SelectedContact}"
                         Margin="0,3,0,3"
                         BorderThickness="0">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Margin" Value="0,0,0,3"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="3">
                                <TextBlock Text="{Binding Name}" 
                                           FontSize="12" 
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding PhoneNumber}" 
                                           FontSize="11" 
                                           Foreground="Gray"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Кнопки внизу -->
                <Grid Grid.Row="2" Margin="0,3,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" 
                            Content="Add" 
                            Command="{Binding AddCommand}"
                            Height="25" 
                            Margin="0,0,3,0"
                            HorizontalContentAlignment="Center"/>

                    <Button Grid.Column="1" 
                            Content="Edit" 
                            Command="{Binding EditCommand}"
                            Height="25" 
                            Margin="3,0,3,0"
                            HorizontalContentAlignment="Center"/>

                    <Button Grid.Column="2" 
                            Content="Remove" 
                            Command="{Binding RemoveCommand}"
                            Height="25" 
                            Margin="3,0,0,0"
                            HorizontalContentAlignment="Center"/>
                </Grid>
            </Grid>
        </Grid>

        <!-- Разделитель -->
        <GridSplitter Grid.Column="1" 
                      Width="3" 
                      HorizontalAlignment="Stretch"
                      Background="White"
                      ResizeBehavior="BasedOnAlignment"/>

        <!-- Правая панель - детали контакта -->
        <Grid Grid.Column="2" Background="White">
            <Grid Margin="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Основная сетка с двумя колонками: фото слева, поля справа -->
                <Grid Grid.Row="0" HorizontalAlignment="Stretch">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Левая колонка: фото -->
                    <Border Grid.Column="0"
                            Width="100" 
                            Height="100"
                            Background="LightGray"
                            BorderBrush="Gray"
                            BorderThickness="1"
                            Margin="0,0,12,0"
                            VerticalAlignment="Top">
                        <TextBlock Text="Фото"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="Gray"/>
                    </Border>

                    <!-- Правая колонка: поля с данными -->
                    <StackPanel Grid.Column="1" HorizontalAlignment="Stretch">
                        <!-- Поле Name -->
                        <TextBlock Text="Name:" 
                                   Margin="0,0,0,3"/>
                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                 IsReadOnly="{Binding IsReadOnly}"
                                 Margin="0,0,0,3"
                                 Padding="3"
                                 HorizontalAlignment="Stretch"/>

                        <!-- Поле Phone Number -->
                        <TextBlock Text="Phone Number:" 
                                   Margin="0,0,0,3"/>
                        <TextBox Text="{Binding PhoneNumber, UpdateSourceTrigger=PropertyChanged}"
                                 IsReadOnly="{Binding IsReadOnly}"
                                 Margin="0,0,0,3"
                                 Padding="3"
                                 HorizontalAlignment="Stretch"/>

                        <!-- Поле Email -->
                        <TextBlock Text="Email:" 
                                   Margin="0,0,0,3"/>
                        <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                                 IsReadOnly="{Binding IsReadOnly}"
                                 Margin="0,0,0,3"
                                 Padding="3"
                                 HorizontalAlignment="Stretch"/>
                    </StackPanel>
                </Grid>

                <!-- Кнопка Apply -->
                <Button Grid.Row="1"
                        Content="Apply"
                        Width="75"
                        Height="25"
                        Margin="0,50,0,0"
                        HorizontalAlignment="Left"
                        Visibility="{Binding IsApplyVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                        Command="{Binding ApplyCommand}"/>
            </Grid>
        </Grid>
    </Grid>
</Window>