<Window x:Class="View.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converters="clr-namespace:View.Converters"
        xmlns:controls="clr-namespace:View.Controls"
        mc:Ignorable="d"
        Title="Contacts" 
        Height="600" 
        Width="800"
        WindowStartupLocation="CenterScreen"
        MinWidth="550" 
        MinHeight="400"
        Icon="/Resources/ContactsApp_96x96.ico">

    <Window.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <!-- Шаблон сохранён в ресурсах с ключом "contactTemplate" -->
        <DataTemplate x:Key="contactTemplate">
            <StackPanel Orientation="Horizontal" Margin="5">

                <!-- Картинка слева -->
                <Image Source="Resources/photo_placeholder_100x100.png" 
               Width="40" 
               Height="40" 
               Margin="0,0,10,0"
               Stretch="UniformToFill"/>

                <!-- Вертикальный StackPanel для текста -->
                <StackPanel>
                    <TextBlock Text="{Binding Name}" 
                       FontSize="14" 
                       FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding PhoneNumber}" 
                       FontSize="12"/>
                </StackPanel>

            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="150"/>
            <ColumnDefinition Width="3"/>
            <ColumnDefinition Width="*" MinWidth="250"/>
        </Grid.ColumnDefinitions>

        <!-- Левая панель - список контактов -->
        <Grid Grid.Column="0">
            <Grid Margin="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Верхняя панель: поле поиска -->
                <Grid Grid.Row="0" Margin="0,0,0,3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" 
                               Text="Find:" 
                               VerticalAlignment="Center"
                               Margin="0,0,5,0"/>

                    <TextBox Grid.Column="1" 
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Height="25" 
                             Padding="3"
                             BorderThickness="1"/>
                </Grid>

                <!-- Список контактов -->
                <ListBox Grid.Row="1" 
                         ItemsSource="{Binding Contacts}"
                         ItemTemplate="{StaticResource contactTemplate}"
                         SelectedItem="{Binding SelectedContact}"
                         Margin="0,3,0,3"
                         BorderThickness="0">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Margin" Value="0,0,0,3"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>

                <!-- Кнопки внизу -->
                <Grid Grid.Row="2" Margin="0,3,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" 
                            Content="Add" 
                            Command="{Binding AddCommand}"
                            Height="25" 
                            Margin="0,0,3,0"
                            HorizontalContentAlignment="Center"/>

                    <Button Grid.Column="1" 
                            Content="Edit" 
                            Command="{Binding EditCommand}"
                            Height="25" 
                            Margin="3,0,3,0"
                            HorizontalContentAlignment="Center"/>

                    <Button Grid.Column="2" 
                            Content="Remove" 
                            Command="{Binding RemoveCommand}"
                            Height="25" 
                            Margin="3,0,0,0"
                            HorizontalContentAlignment="Center"/>
                </Grid>
            </Grid>
        </Grid>

        <!-- Разделитель -->
        <GridSplitter Grid.Column="1" 
                      Width="3" 
                      HorizontalAlignment="Stretch"
                      ResizeBehavior="BasedOnAlignment"/>

        <!-- Правая панель - детали контакта -->
        <Grid Grid.Column="2">
            <Grid Margin="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Правая панель: UserControl -->
                <controls:ContactControl Grid.Row="0"
                         DataContext="{Binding EditableContact}"
                         IsReadOnly="{Binding DataContext.IsReadOnly,
 RelativeSource={RelativeSource AncestorType=Window}}"/>

                <!-- Кнопка Apply -->
                <Button Grid.Row="1"
                        Content="Apply"
                        Width="75"
                        Height="25"
                        Margin="115,50,0,0"
                        HorizontalAlignment="Left"
                        Visibility="{Binding IsApplyVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                        Command="{Binding ApplyCommand}"/>
            </Grid>
        </Grid>
    </Grid>
</Window>