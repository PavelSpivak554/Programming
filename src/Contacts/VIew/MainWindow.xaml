<Window x:Class="View.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:View"
        mc:Ignorable="d"
        Title="MainWindow"
        Height="450"
        Width="500"
        Icon="ContactsApp_96x96.ico">

    <!-- Поля окна 15px с каждой стороны -->
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Основная панель с двумя колонками -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- EDIT CONTACT - Левая панель -->
            <GroupBox Grid.Column="0" 
                      Header="Edit Contact"
                      Margin="0 0 3 0"
                      Padding="3">
                <StackPanel>
                    <!-- Name -->
                    <Label Content="Name:" 
                           Margin="0 0 0 3"
                           Padding="0"/>
                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0 0 0 10"/>

                    <!-- Phone Number -->
                    <Label Content="Phone Number:" 
                           Margin="0 0 0 3"
                           Padding="0"/>
                    <TextBox Text="{Binding PhoneNumber, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0 0 0 10"/>

                    <!-- Email -->
                    <Label Content="Email:" 
                           Margin="0 0 0 3"
                           Padding="0"/>
                    <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
            </GroupBox>

            <!-- READ CONTACT - Правая панель -->
            <GroupBox Grid.Column="1" 
                      Header="Read Contact" 
                      Margin="3 0 0 0"
                      Padding="3">
                <StackPanel>
                    <!-- Name -->
                    <Label Content="Name:" 
                           Margin="0 0 0 3"
                           Padding="0"/>
                    <TextBlock Text="{Binding Name}"
                               FontWeight="Bold"
                               Margin="0 0 0 10"/>

                    <!-- Phone Number -->
                    <Label Content="Phone Number:" 
                           Margin="0 0 0 3"
                           Padding="0"/>
                    <TextBlock Text="{Binding PhoneNumber}"
                               FontWeight="Bold"
                               Margin="0 0 0 10"/>
                    
                    <!-- Email -->
                    <Label Content="Email:" 
                           Margin="0 0 0 3"
                           Padding="0"/>
                    <TextBlock Text="{Binding Email}"
                               FontWeight="Bold"/>
                </StackPanel>
            </GroupBox>
        </Grid>

        <!-- Кнопки сохранения и загрузки -->
        <StackPanel Grid.Row="2" 
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0 10 0 0">

            <Button Content="Save" 
                    Width="75" 
                    Height="25" 
                    Margin="0 0 3 0"
                    Command="{Binding SaveCommand}"
                    CommandParameter="{Binding CurrentContact}"/>

            <Button Content="Load" 
                    Width="75" 
                    Height="25"
                    Command="{Binding LoadCommand}"
                    CommandParameter="{Binding CurrentContact}"/>
        </StackPanel>
    </Grid>
</Window>