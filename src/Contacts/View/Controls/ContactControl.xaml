<UserControl x:Class="View.Controls.ContactControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:View.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    
    <!-- Основная сетка с двумя колонками: фото слева, поля справа -->
    <Grid
                    Grid.Row="0" HorizontalAlignment="Stretch">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Левая колонка: фото -->
        <Border 
                            Width="100" 
                            Height="100"
                            BorderThickness="2"
                            Margin="0,20,12,0">
            <Image Source="/Resources/photo_placeholder_100x100.png"
                               Stretch="UniformToFill"/>
        </Border>

        <!-- Правая колонка: поля с данными -->
        <StackPanel Grid.Column="1" HorizontalAlignment="Stretch">
            <!-- Поле Name -->
            <TextBlock Text="Name:" 
                                   Margin="0,0,0,3"/>
            <TextBox Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 IsReadOnly="{Binding IsReadOnly,RelativeSource={RelativeSource AncestorType=UserControl}}"
                                 Margin="0,0,0,3"
                                 Padding="3"
                                 HorizontalAlignment="Stretch"/>

            <!-- Поле Phone Number -->
            <TextBlock Text="Phone Number:" 
                                   Margin="0,0,0,3"/>
            <TextBox Text="{Binding PhoneNumber, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                                 IsReadOnly="{Binding IsReadOnly, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                 Margin="0,0,0,3"
                                 Padding="3"
                                 HorizontalAlignment="Stretch"/>

            <!-- Поле Email -->
            <TextBlock Text="Email:" 
                                   Margin="0,0,0,3"/>
            <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                                 IsReadOnly="{Binding IsReadOnly,RelativeSource={RelativeSource AncestorType=UserControl}}"
                                 Margin="0,0,0,3"
                                 Padding="3"
                                 HorizontalAlignment="Stretch"/>
        </StackPanel>
    </Grid>

</UserControl>
